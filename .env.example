# ==============================================================================
# BeautyAura.ai — Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit '.env.local' or live production secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. InsForge Backend-as-a-Service (Postgres, Auth, Storage, Edge Functions)
# ------------------------------------------------------------------------------
# Your project's base API URL provided by InsForge Cloud
NEXT_PUBLIC_INSFORGE_URL=https://your-app-key.region.insforge.app

# Public Anonymous API Key (used by client-side browser SDK for auth & public storage)
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_your_insforge_public_anon_key_here

# Server-Only Admin Key (ik_...) - Grants privileged access in server routes.
# NEVER expose this key in public client bundles or NEXT_PUBLIC_* variables.
INSFORGE_API_KEY=ik_your_insforge_admin_api_key_here

# ------------------------------------------------------------------------------
# 2. Stripe Payments & Subscription Billing
# ------------------------------------------------------------------------------
# Stripe Secret API Key (test or live) for checkout sessions, subscriptions, and portal
STRIPE_TEST_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ------------------------------------------------------------------------------
# 3. YouCam AI Engine MCP Servers (Beauty, Fashion & Creators)
# ------------------------------------------------------------------------------
# API Key for YouCam AI Studio MCP streaming JSON-RPC endpoints
NEXT_YOUCAM_API_KEY=sk-your_youcam_api_key_here

# Public/Secret RSA key pair used for request authentication with YouCam MCP
NEXT_YOUCAM_SECRET_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC...your_secret_key_here...IDAQAB

# ------------------------------------------------------------------------------
# 4. Optional Application Settings
# ------------------------------------------------------------------------------
# Canonical App URL (defaults to http://localhost:3000 in local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

